# Copy to .env for local development (uv run ...). In production these are set in the Render dashboard.
APP_ENV=development
LOG_LEVEL=info

# Local: the compose database (docker compose up -d db). Production: the Supabase session pooler, port 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bbunikoop
DB_POOL_SIZE=5

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
