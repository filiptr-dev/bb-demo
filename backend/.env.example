# Copy to .env for local development (uv run ...). In production these are set in the Render dashboard.
APP_ENV=development
LOG_LEVEL=info

# Local: the compose database (docker compose up -d db). Production: the Supabase session pooler, port 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bbunikoop
DB_POOL_SIZE=5

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: a regex for origins that can't be listed, e.g. Vercel previews: https://bb-demo-[a-z0-9-]+\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEX=

# Optional: refresh the site's cached pages after a data change (both or neither).
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=

# Assistant: a Google AI Studio key. Without it, free-text questions answer with an error event.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
