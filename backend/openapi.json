              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "title": "Data"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Page[Product]"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status",
          "code"
        ],
        "title": "Problem"
      },
      "Product": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "designation": {
            "type": "string",
            "title": "Designation"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "classification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classification"
          },
          "d": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "D"
          },
          "D": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "D"
          },
          "B": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "B"
          },
          "seal": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "open",
                  "shields",
                  "both",
                  "one-side",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Seal"
          },
          "boreType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "cylindrical",
                  "tapered"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Boretype"
          },
          "industries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Industries"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "designation",
          "brand",
          "type",
          "classification",
          "d",
          "D",
          "B",
          "seal",
          "boreType",
          "industries"
        ],
        "title": "Product",
        "description": "A catalog row. Dimensions use SKF's notation: d = bore, D = outside diameter, B = width (all mm)."
      },
      "ProductList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ProductList"
      },
      "ProductStats": {
