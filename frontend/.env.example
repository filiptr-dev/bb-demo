# Copy to .env.local for local development. On Vercel, set these per environment (Production and Preview).

# The B&B Unikoop API (backend/). Server renders use API_URL, the browser NEXT_PUBLIC_API_URL (same URL is fine).
# Local: http://localhost:8000 (`docker compose up -d` in the repo root). Vercel: https://<your-service>.onrender.com
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret for POST /api/revalidate (the API calls it when catalog data changes). Any long random string.
REVALIDATE_SECRET=

# Only for `npm run db:import` (fills the products table until the importer moves to the backend in phase 7).
DATABASE_URL=

# Contact form email (optional; without them the form only logs).
RESEND_API_KEY=
CONTACT_TO=
